# ---------------------------------------------------------------------------
# Bot configuration
#
# Copy this file to `.env` and fill in what you need. Every value below is
# optional except TOKEN. Lines left as `NAME=` fall back to the default noted in
# the description, so you only need to set the ones you want to change.
#
# Restart the bot after editing; values are read once at startup.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Discord bot token. Create one at https://discord.com/developers/applications
# under your application > Bot > Reset Token. The bot needs the "bot" scope and,
# for the music commands, the Connect, Speak and Embed Links permissions.
TOKEN=


# ---------------------------------------------------------------------------
# General behaviour
# ---------------------------------------------------------------------------

# Prefix for the message (non-slash) form of every command. Both "!name" and
# "/name" always work, so this only affects the plain text style.
# Default: !
COMMAND_PREFIX=!

# Text shown in the footer of every embed. Leave empty for no footer.
# Example: MyServer Music Bot
# Default: none
FOOTER_TEXT=

# How long a confirmation button stays clickable, for the commands that ask
# before acting (clear, kick, ban, lock). After this the buttons stop working.
# Default: 15000
CONFIRM_TIMEOUT=15000

# Commands to hide, separated by commas. Use this to switch off anything you do
# not want, without editing any code. Group switches below are coarser.
# Example: 24,coinflip,servercount
# Default: none
DISABLED_COMMANDS=


# ---------------------------------------------------------------------------
# Command groups
#
# Set any of these to false to hide that whole group from the help command and
# refuse to run its commands. Handy while you are still building a category.
# Default: true for all four
# ---------------------------------------------------------------------------

GROUP_UTILITY=true
GROUP_MODERATION=true
GROUP_FUN=true
GROUP_MUSIC=true


# ---------------------------------------------------------------------------
# Lavalink
#
# All audio work happens on a Lavalink v4 server: the bot only asks it to
# resolve links and play tracks. Copy the host, port and password from the
# server's application.yml (or from your Lavalink host).
#
# LAVALINK_HOST is the hostname or IP only, without a scheme or port. Set
# LAVALINK_SECURE=true if the server is behind TLS (wss/https).
# ---------------------------------------------------------------------------

LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Node identifier used in connection logs.
# Default: main
LAVALINK_NAME=main

# "Lavalink" or "NodeLink". Use NodeLink for yt-dlp-based YouTube playback.
# Default: Lavalink
LAVALINK_NODE_TYPE=Lavalink

# Source used for plain text searches. "ytmsearch" usually gives better music
# results when the server has YouTube Music enabled; "ytsearch" is the safest.
# Default: ytsearch
LAVALINK_SEARCH=ytsearch

# Volume new players start at, from 0 to 100.
# Default: 100
LAVALINK_VOLUME=100


# ---------------------------------------------------------------------------
# Album lookup (/album)
#
# Album names are looked up through Deezer's public API, which needs no account
# and returns the full tracklist. Only the metadata comes from there; each track
# is matched through Lavalink when it starts.
# ---------------------------------------------------------------------------

# Set to false to turn /album off entirely.
# Default: true
ALBUM_SEARCH=true

# Most tracks one /album may add to the queue, to protect against very long
# compilations. Anything longer is truncated and the embed says so.
# Default: 50
ALBUM_MAX_TRACKS=50
